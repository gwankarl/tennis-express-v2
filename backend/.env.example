# Application environment: development, test, or production.
# Optional; defaults to development.
NODE_ENV=development

# Backend HTTP port (1-65535).
# Optional; defaults to 5000.
PORT=5000

# MongoDB connection URI.
# Required. This example targets the local development database.
MONGODB_URI=mongodb://127.0.0.1:27017/tennis_xpress_v2

# Frontend origin used by the backend for browser requests.
# Required.
CLIENT_URL=http://localhost:5173

# Email Configuration
EMAIL_PROVIDER=mock
EMAIL_ENABLED=false

# Resend Configuration
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=


# Password-reset token lifetime in seconds (300-3600).
# Optional; defaults to 1800 (30 minutes).
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Enables the simulated integrated payment providers.
# Keep disabled unless this deployment is intentionally using mock payments.
PAYMENT_SIMULATION_ENABLED=false

# Delay before the mock provider processes a configured outcome (0-60000 ms).
MOCK_PAYMENT_PROCESSING_DELAY_MS=1500

# Mock scenarios: success, failure, cancelled, pending, timeout,
# provider_error, amount_mismatch, currency_mismatch, duplicate_notification.
MOCK_PAYMENT_PROVIDER_1_SCENARIO=success
MOCK_PAYMENT_PROVIDER_2_SCENARIO=success